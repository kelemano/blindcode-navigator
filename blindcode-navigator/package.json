{
  "name": "blindcode-navigator",
  "displayName": "blindcode-navigator",
  "description": "AST-based audio navigation and sonification for blind Java programming beginners.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "blindcodeTreeContainer",
          "title": "BlindCode Baum",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "blindcodeTreeContainer": [
        {
          "id": "blindcodeTree",
          "name": "Baum",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "BlindCode Navigator",
      "properties": {
        "blindcode.studyCondition": {
          "type": "string",
          "enum": ["A", "B", "C"],
          "enumDescriptions": [
            "A — Kontrolle: Extension aus (nur Screenreader).",
            "B — Navigation + Kontext-Sprachausgabe, ohne Sonifikation.",
            "C — alles an: Navigation + Sprache + Sonifikation."
          ],
          "default": "C",
          "description": "Studienbedingung (A/B/C). Schaltet die Funktionen je Bedingung für die Vergleichsstudie."
        },
        "blindcode.speechMechanism": {
          "type": "string",
          "enum": ["ariaLive", "notification"],
          "enumDescriptions": [
            "Verstecktes Webview mit aria-live-Region (Standard, nicht aufdringlich).",
            "Benachrichtigung via showInformationMessage (garantierter Fallback, aufdringlich)."
          ],
          "default": "ariaLive",
          "description": "Wie die Kontext-Sprachausgabe an den Screenreader übergeben wird."
        },
        "blindcode.sonification": {
          "type": "boolean",
          "default": true,
          "description": "Sonifikation: Verschachtelungstiefe als Tonhöhe bei der Navigation (FF2). In Studienbedingung B aus, in C an."
        },
        "blindcode.sonification.depthMode": {
          "type": "string",
          "enum": ["control", "control-and-methods", "full-scope"],
          "enumDescriptions": [
            "Nur Kontroll-Verschachtelung: zählt jeden Knoten als Ebene, OHNE Klasse/Methode und OHNE then/else-Zweige (Standard; MathLogic: if=1, for=2, inneres if=3, println=4).",
            "Wie control, aber die Methode zählt mit (alles +1; println=5).",
            "Klasse und Methode zählen mit (println=6)."
          ],
          "default": "control",
          "description": "Welche Tiefe die Sonifikation auf die Tonhöhe abbildet (reine Projektion aus dem Outline-Baum; ändert NICHT Baumansicht oder Sprachausgabe)."
        },
        "blindcode.sonification.customDepthNodeTypes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Optional (Profi): Wenn nicht leer, überschreibt depthMode — nur diese tree-sitter-Knotentypen erhöhen die Tiefe, z. B. [\"if_statement\",\"for_statement\",\"while_statement\",\"method_declaration\"]."
        }
      }
    },
    "commands": [
      {
        "command": "blindcode-navigator.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "blindcode-navigator.navigateDown",
        "title": "BCNav: Nächster Knoten (Lesereihenfolge)"
      },
      {
        "command": "blindcode-navigator.navigateUp",
        "title": "BCNav: Vorheriger Knoten (Lesereihenfolge)"
      },
      {
        "command": "blindcode-navigator.navigateNextSibling",
        "title": "BCNav: Nächstes Geschwister (Block überspringen)"
      },
      {
        "command": "blindcode-navigator.navigateOut",
        "title": "BCNav: Eine Ebene heraus"
      },
      {
        "command": "blindcode-navigator.showOutline",
        "title": "BCNav: Gliederung anzeigen / zu Knoten springen"
      },
      {
        "command": "blindcode-navigator.showTree",
        "title": "BCNav: Baumansicht anzeigen (Visualisierung/Debug)"
      },
      {
        "command": "blindcode-navigator.toggleSonification",
        "title": "BCNav: Sonifikation an/aus"
      },
      {
        "command": "blindcode-navigator.setStudyCondition",
        "title": "BCNav: Studienbedingung wählen (A/B/C)"
      }
    ],
    "keybindings": [
      {
        "command": "blindcode-navigator.navigateDown",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateUp",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateNextSibling",
        "key": "alt+right",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateOut",
        "key": "alt+left",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.showOutline",
        "key": "alt+o",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.showTree",
        "key": "alt+t",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.toggleSonification",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == 'java'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run compile && npm run lint",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "mocha": "^11.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5"
  }
}
