{
  "name": "blindcode-navigator",
  "displayName": "blindcode-navigator",
  "description": "AST-based audio navigation and sonification for blind Java programming beginners.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "BlindCode Navigator",
      "properties": {
        "blindcode.speechMechanism": {
          "type": "string",
          "enum": ["ariaLive", "notification"],
          "enumDescriptions": [
            "Verstecktes Webview mit aria-live-Region (Standard, nicht aufdringlich).",
            "Benachrichtigung via showInformationMessage (garantierter Fallback, aufdringlich)."
          ],
          "default": "ariaLive",
          "description": "Wie die Kontext-Sprachausgabe an den Screenreader übergeben wird."
        }
      }
    },
    "commands": [
      {
        "command": "blindcode-navigator.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "blindcode-navigator.navigateDown",
        "title": "BCNav: Nächster Knoten (Lesereihenfolge)"
      },
      {
        "command": "blindcode-navigator.navigateUp",
        "title": "BCNav: Vorheriger Knoten (Lesereihenfolge)"
      },
      {
        "command": "blindcode-navigator.navigateIn",
        "title": "BCNav: Eine Ebene hinein"
      },
      {
        "command": "blindcode-navigator.navigateOut",
        "title": "BCNav: Eine Ebene heraus"
      }
    ],
    "keybindings": [
      {
        "command": "blindcode-navigator.navigateDown",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateUp",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateIn",
        "key": "alt+right",
        "when": "editorTextFocus && editorLangId == 'java'"
      },
      {
        "command": "blindcode-navigator.navigateOut",
        "key": "alt+left",
        "when": "editorTextFocus && editorLangId == 'java'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run compile && npm run lint",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "mocha": "^11.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5"
  }
}
